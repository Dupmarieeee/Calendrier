{
  "name": "givre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Planning de la semaine, statistiques de temps et suivi du Winter Arc — pensé pour iPhone.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
