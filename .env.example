# Copiez ce fichier en .env (en local) ou renseignez ces variables chez votre hébergeur.
# Identifiants OAuth « Application Web » créés dans Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Chaîne aléatoire longue (ex. `openssl rand -hex 32`) qui chiffre le jeton Google stocké sur l'iPhone.
SESSION_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# URL publique de l'application (sans / final). Facultatif : déduite de la requête si absente.
APP_URL=https://votre-app.onrender.com
PORT=8787
